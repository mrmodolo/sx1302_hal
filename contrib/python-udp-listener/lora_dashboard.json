    {
        "id": "55668c4e8294384d",
        "type": "mqtt in",
        "z": "flow_loRaGatewayRx",
        "name": "LoRa Gateway RX",
        "topic": "lora/gateway/RX",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 80,
        "wires": [
            [
                "decode_payload"
            ]
        ]
    },
    {
        "id": "decode_payload",
        "type": "function",
        "z": "flow_loRaGatewayRx",
        "name": "Decodificar payload LoRa",
        "func": "const pkt = msg.payload;\nif (!pkt || !pkt.data) {\n    return null;\n}\n\nconst raw = Buffer.from(pkt.data, 'base64').toString('utf8');\nmsg.rawPayload = raw;\n\nconst result = {};\nraw.split(',').forEach(part => {\n    const [key, val] = part.split(':');\n    const num = parseFloat(val);\n    if (key === 'T') result.temperature = num;\n    else if (key === 'H') result.humidity = num;\n    else if (key === 'N') result.packet = parseInt(val);\n});\n\nmsg.payload = result;\nmsg.rssi = pkt.rssi;\nmsg.snr = pkt.lsnr;\nmsg.freq = pkt.freq;\nmsg.time = pkt.time;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 80,
        "wires": [
            [
                "gauge_temp",
                "gauge_hum",
                "text_info",
                "change_temp_chart",
                "debug_loRa"
            ]
        ]
    },

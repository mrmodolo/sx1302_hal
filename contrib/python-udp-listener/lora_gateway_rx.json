      "active": true,
      "tosidebar": true,
      "console": 0,
      "outputs": 0,
      "noerr": 0,
      "initialize": "",
      "finalize": "",
      "libs": [],
      "x": 420,
      "y": 80,
      "wires": []
    }
  ],
  "connections": [
    {
      "id": "conn_1",
      "type": "mqtt in",
      "from": ["mqtt_broker_1", "broker"],
      "to": ["debug_1", "debug"],
      "data": []
    }
  ],
  "settings": {},
  "disabled": false

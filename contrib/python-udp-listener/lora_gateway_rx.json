    {
        "id": "decode_payload",
        "type": "function",
        "z": "4d2b716d16ffd364",
        "name": "Decodificar payload LoRa",
        "func": "const pkt = msg.payload;\nif (!pkt || !pkt.data) {\n    return null;\n}\n\n// Decodificar Base64 -> string\nconst raw = Buffer.from(pkt.data, 'base64').toString('utf8');\nmsg.rawPayload = raw;\n\n// Parsear \"T:25.3C,H:60.2%,N:1\"\nconst result = {};\nraw.split(',').forEach(part => {\n    const [key, val] = part.split(':');\n    const num = parseFloat(val);\n    if (key === 'T') result.temperature = num;\n    else if (key === 'H') result.humidity = num;\n    else if (key === 'N') result.packet = parseInt(val);\n});\n\nmsg.payload = result;\nmsg.rssi = pkt.rssi;\nmsg.snr = pkt.lsnr;\nmsg.freq = pkt.freq;\nmsg.time = pkt.time;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

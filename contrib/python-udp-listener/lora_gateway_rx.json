{
  "version": "0.1.0",
  "description": "LoRaWAN SX1302 UDP -> MQTT -> Node-RED",
  "defaults": {},
  "x": 0,
  "y": 0,
  "nodes": [
    {
      "id": "mqtt_broker_1",

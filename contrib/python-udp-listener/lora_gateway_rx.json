      "broker": "127.0.0.1",
      "port": "1883",
      "clientid": "",
      "usetls": false,
      "compatmode": true,
      "keepClean": true,
      "cleansession": false,
      "birthTopic": "",
      "birthMsg": "",
      "closeTopic": "",
      "closeMsg": "",
      "willTopic": "",
      "willMsg": ""
    },
    {
      "id": "mqtt_in_1",
      "type": "mqtt in",
      "z": "nodered_flow_1",
      "name": "LoRa Gateway RX",
      "topic": "lora/gateway/RX",
      "qos": 0,
      "datatype": "auto",

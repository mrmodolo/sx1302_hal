[Unit]
Description=SX1302 LoRaWAN Packet Forwarder (Local)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sx1302_hal/
ExecStartPre=/opt/sx1302_hal/reset_lgw.sh
ExecStart=/opt/sx1302_hal/lora_pkt_fwd -c /opt/sx1302_hal/local_conf.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
